{
	"expo": {
		"name": "vantage",
		"slug": "vantage",
		"version": "0.1.0",
		"orientation": "portrait",
		"icon": "./public/icon512.png",
		"userInterfaceStyle": "dark",
		"backgroundColor": "#242424",
		"ios": {
			"supportsTablet": true
		},
		"scheme": "vantage",
		"experiments": {
			"tsconfigPaths": true,
			"typedRoutes": true
		},
		"android": {
			"package": "lt.tsx.vantage",
			"predictiveBackGestureEnabled": false,
			"versionCode": 1,
			"intentFilters": [
				{
					"action": "VIEW",
					"data": [
						{
							"scheme": "https",
							"host": "vantage.tsx.lt"
						}
					],
					"autoVerify": true,
					"category": ["BROWSABLE", "DEFAULT"]
				},
				{
					"action": "VIEW",
					"data": [
						{
							"scheme": "https",
							"host": "eventsl.ink"
						}
					],
					"autoVerify": true,
					"category": ["BROWSABLE", "DEFAULT"]
				},
				{
					"action": "VIEW",
					"data": [
						{
							"scheme": "vantage"
						}
					],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			]
		},
		"web": {
			"output": "single",
			"bundler": "metro",
			"favicon": "./public/icon.svg"
		},
		"plugins": [
			"expo-router",
			"expo-status-bar",
			[
				"expo-font",
				{
					"fonts": ["./node_modules/@expo-google-fonts/lexend/400Regular/Lexend_400Regular.ttf"]
				}
			],
			"expo-splash-screen",
			"expo-localization",
			"react-native-map-link",
			"expo-sharing",
			"react-native-enriched-markdown",
			"expo-sqlite"
		],
		"extra": {
			"router": {},
			"eas": {
				"projectId": "9606801f-d84a-4797-8de6-7b463aa92131"
			}
		}
	}
}
