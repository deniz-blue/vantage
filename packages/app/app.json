{
	"expo": {
		"name": "app",
		"slug": "app",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./public/icon512.png",
		"userInterfaceStyle": "dark",
		"backgroundColor": "#242424",
		"ios": {
			"supportsTablet": true
		},
		"scheme": "vantage",
		"experiments": {
			"tsconfigPaths": true,
			"typedRoutes": true
		},
		"android": {
			"predictiveBackGestureEnabled": true,
			"package": "blue.deniz.vantage"
		},
		"web": {
			"output": "single",
			"bundler": "webpack",
			"favicon": "./public/favicon.ico"
		},
		"plugins": [
			"expo-router",
			"expo-status-bar",
			"expo-font",
			"expo-splash-screen",
			"expo-sqlite"
		]
	}
}